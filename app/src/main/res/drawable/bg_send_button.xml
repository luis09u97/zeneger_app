<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><gradient android:angle="135" android:startColor="@color/button_pressed_start" android:endColor="@color/button_pressed_end"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/primary_light"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="135" android:startColor="@color/button_gradient_start" android:centerColor="@color/button_gradient_center" android:endColor="@color/button_gradient_end"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/primary_light"/></shape>
    </item>
</selector>
