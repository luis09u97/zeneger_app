<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="@color/input_focus_start" android:endColor="@color/input_focus_end"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="@color/primary_light"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="@color/input_gradient_start" android:endColor="@color/input_gradient_end"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="@color/control_stroke"/>
        </shape>
    </item>
</selector>
