<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><gradient android:angle="135" android:startColor="@color/list_pressed_start" android:endColor="@color/list_pressed_end"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/control_stroke_strong"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="135" android:startColor="@color/list_gradient_start" android:endColor="@color/list_gradient_end"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/control_stroke"/></shape>
    </item>
</selector>
