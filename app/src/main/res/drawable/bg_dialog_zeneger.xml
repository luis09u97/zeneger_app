<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="@color/surface_gradient_center"
                android:endColor="@color/sheet_gradient_end"
                android:startColor="@color/sheet_gradient_start" />
            <corners android:radius="27dp" />
            <stroke android:width="1dp" android:color="@color/control_stroke_strong" />
        </shape>
    </item>
</layer-list>
