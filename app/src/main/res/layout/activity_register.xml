<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/auth_horizontal_padding"
        android:paddingEnd="@dimen/auth_horizontal_padding"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <com.seunome.zeneger.AuthBrandAvatar
            android:layout_width="@dimen/brand_mark_size"
            android:layout_height="@dimen/brand_mark_size"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar conta"
            android:textSize="30sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Junte-se ao Zeneger"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="40dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="28dp"
            android:elevation="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informações da conta"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/nameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Seu nome"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:background="@drawable/bg_input"
                    android:paddingStart="50dp"
                    android:paddingEnd="18dp"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_zen_person" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/emailEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="E-mail"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:background="@drawable/bg_input"
                    android:inputType="textEmailAddress"
                    android:paddingStart="50dp"
                    android:paddingEnd="18dp"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_zen_email" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Senha (mínimo 6 caracteres)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:background="@drawable/bg_input"
                    android:inputType="textPassword"
                    android:paddingStart="50dp"
                    android:paddingEnd="52dp"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_zen_lock" />

                <ImageButton
                    android:id="@+id/passwordToggle"
                    android:layout_width="@dimen/inline_action_size"
                    android:layout_height="@dimen/inline_action_size"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar senha"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_zen_visibility_off" />

            </FrameLayout>

            <Button
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:text="CADASTRAR"
                android:background="@drawable/bg_button"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/loginLink"
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_touch_size"
                android:text="Já tem conta? Faça login"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

</FrameLayout>
