<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_toolbar_glass"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="@dimen/action_touch_size"
            android:layout_height="@dimen/action_touch_size"
            app:srcCompat="@drawable/ic_zen_back"
            app:tint="@color/icon_toolbar"
            android:padding="12dp"
            android:background="@drawable/bg_icon_button"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Novo Grupo"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <!-- Nome do grupo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_button_height"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="@dimen/settings_icon_size"
                android:layout_height="@dimen/settings_icon_size"
                app:srcCompat="@drawable/ic_zen_group"
                app:tint="@color/text_hint"
                android:layout_marginEnd="12dp"/>

            <EditText
                android:id="@+id/groupNameEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Nome do grupo"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@null"
                android:textSize="16sp"
                android:singleLine="true"/>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECIONE OS PARTICIPANTES"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contactsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="5dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/createGroupBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/field_height"
        android:text="CRIAR GRUPO"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:gravity="center"
        android:background="@drawable/bg_button"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:elevation="10dp"/>

</LinearLayout>
