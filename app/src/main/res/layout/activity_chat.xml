<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_chat">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_toolbar_glass"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/action_touch_size"
            android:layout_height="@dimen/action_touch_size"
            app:srcCompat="@drawable/ic_zen_back"
            android:background="@drawable/bg_icon_button"
            app:tint="@color/icon_toolbar"
            android:padding="12dp"/>

        <FrameLayout
            android:layout_width="@dimen/compact_touch_size"
            android:layout_height="@dimen/compact_touch_size"
            android:layout_marginEnd="12dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/toolbarAvatar"
                android:layout_width="@dimen/compact_touch_size"
                android:layout_height="@dimen/compact_touch_size"
                android:src="@drawable/bg_avatar"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/toolbarAvatarLetter"
                android:layout_width="@dimen/compact_touch_size"
                android:layout_height="@dimen/compact_touch_size"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar"/>

            <View
                android:id="@+id/toolbarOnlineDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone"/>

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toolbarName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/toolbarStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="online"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/videoCallBtn"
            android:layout_width="@dimen/action_touch_size"
            android:layout_height="@dimen/action_touch_size"
            app:srcCompat="@drawable/ic_zen_video"
            app:tint="@color/icon_toolbar"
            android:padding="12dp"
            android:background="@drawable/bg_icon_button"/>

        <ImageView
            android:id="@+id/callBtn"
            android:layout_width="@dimen/action_touch_size"
            android:layout_height="@dimen/action_touch_size"
            app:srcCompat="@drawable/ic_zen_call"
            app:tint="@color/icon_toolbar"
            android:padding="12dp"
            android:background="@drawable/bg_icon_button"/>

        <ImageView
            android:id="@+id/optionsBtn"
            android:layout_width="@dimen/action_touch_size"
            android:layout_height="@dimen/action_touch_size"
            app:srcCompat="@drawable/ic_zen_more"
            app:tint="@color/icon_toolbar"
            android:padding="12dp"
            android:contentDescription="Mais opções"
            android:background="@drawable/bg_icon_button"/>

    </LinearLayout>

    <!-- Mensagem fixada -->
    <LinearLayout
        android:id="@+id/pinnedContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="32dp"
            android:background="@color/primary"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/pinnedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

    <!-- Mensagens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false"/>

    <!-- Digitando -->
    <TextView
        android:id="@+id/typingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="digitando..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-light"
        android:paddingStart="18dp"
        android:paddingBottom="4dp"
        android:visibility="gone"/>

    <!-- Reply container -->
    <LinearLayout
        android:id="@+id/replyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary_surface"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/primary"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/replyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <ImageView
            android:id="@+id/cancelReplyBtn"
            android:layout_width="@dimen/inline_action_size"
            android:layout_height="@dimen/inline_action_size"
            app:srcCompat="@drawable/ic_zen_close"
            app:tint="@color/text_secondary"
            android:padding="6dp"
            android:background="@drawable/bg_icon_button"/>

    </LinearLayout>

    <!-- Campo de mensagem -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_card_rounded"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:elevation="10dp">

        <ImageView
            android:id="@+id/attachBtn"
            android:layout_width="@dimen/compact_touch_size"
            android:layout_height="@dimen/compact_touch_size"
            app:srcCompat="@drawable/ic_zen_attach"
            app:tint="@color/text_secondary"
            android:padding="10dp"
            android:background="@drawable/bg_icon_button"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/composer_height"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/messageEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Mensagem"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@null"
                android:textSize="16sp"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"/>

            <ImageView
                android:id="@+id/emojiBtn"
                android:layout_width="@dimen/inline_action_size"
                android:layout_height="@dimen/inline_action_size"
                app:srcCompat="@drawable/ic_zen_smile"
                app:tint="@color/text_hint"
                android:padding="4dp"
                android:background="@drawable/bg_icon_button"/>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/sendButton"
            android:layout_width="@dimen/composer_height"
            android:layout_height="@dimen/composer_height"
            android:background="@drawable/bg_send_button">

            <ImageView
                android:layout_width="@dimen/action_icon_size"
                android:layout_height="@dimen/action_icon_size"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_zen_send"
                app:tint="@color/icon_on_accent"/>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
