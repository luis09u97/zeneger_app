<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@drawable/bg_toolbar_glass"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zeneger"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"/>

            <ImageView
                android:id="@+id/addContactBtn"
                android:layout_width="@dimen/action_touch_size"
                android:layout_height="@dimen/action_touch_size"
                app:srcCompat="@drawable/ic_zen_add_person"
                app:tint="@color/icon_toolbar"
                android:padding="12dp"
                android:background="@drawable/bg_icon_button"/>

            <ImageView
                android:id="@+id/createGroupBtn"
                android:layout_width="@dimen/action_touch_size"
                android:layout_height="@dimen/action_touch_size"
                app:srcCompat="@drawable/ic_zen_group"
                app:tint="@color/icon_toolbar"
                android:padding="12dp"
                android:background="@drawable/bg_icon_button"/>

            <ImageView
                android:id="@+id/settingsBtn"
                android:layout_width="@dimen/action_touch_size"
                android:layout_height="@dimen/action_touch_size"
                app:srcCompat="@drawable/ic_zen_settings"
                app:tint="@color/icon_toolbar"
                android:padding="12dp"
                android:background="@drawable/bg_icon_button"/>

        </LinearLayout>

        <!-- Abas principais -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_touch_size"
            android:orientation="horizontal"
            android:background="@drawable/bg_toolbar_glass">

            <TextView
                android:id="@+id/tabChats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="CONVERSAS"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tabStories"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="STATUS"
                android:gravity="center"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:letterSpacing="0.05"/>

        </LinearLayout>

        <!-- Indicador de aba -->
        <View
            android:id="@+id/tabIndicator"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/primary_light"/>

        <!-- Conteúdo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- PAINEL CONVERSAS -->
            <LinearLayout
                android:id="@+id/chatsPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Barra de busca -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_height"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_search"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_zen_search"
                            app:tint="@color/text_hint"
                            android:layout_marginEnd="10dp"/>

                        <EditText
                            android:id="@+id/searchConversations"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Buscar conversas"
                            android:textColorHint="@color/text_hint"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:background="@null"
                            android:inputType="text"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Filtros -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:background="@drawable/bg_card_rounded">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/filterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/chip_height"
                            android:text="Todas"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/bg_chip_active"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/filterUnread"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/chip_height"
                            android:text="Não lidas"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/filterGroups"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/chip_height"
                            android:text="Grupos"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/filterFavorites"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/chip_height"
                            android:text="Favoritos"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/bg_chip_inactive"/>

                    </LinearLayout>

                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"/>

                <!-- Lista de conversas -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/usersRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"/>

            </LinearLayout>

            <!-- PAINEL STORIES -->
            <LinearLayout
                android:id="@+id/storiesPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@android:color/transparent"
                android:visibility="gone">

                <!-- Meu Story -->
                <LinearLayout
                    android:id="@+id/myStoryBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/story_item_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="@dimen/story_avatar_size"
                        android:layout_height="@dimen/story_avatar_size"
                        android:layout_marginEnd="16dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/myStoryImage"
                            android:layout_width="@dimen/story_avatar_size"
                            android:layout_height="@dimen/story_avatar_size"
                            android:src="@drawable/bg_avatar"/>

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_send_button">

                            <TextView
                                android:id="@+id/myStoryAdd"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="+"
                                android:textSize="17sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:textStyle="bold"/>

                        </FrameLayout>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meu status"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/myStorySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toque para adicionar"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ATUALIZAÇÕES RECENTES"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/storiesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"/>

            </LinearLayout>

            <!-- FAB -->
            <FrameLayout
                android:id="@+id/fabNewChat"
                android:layout_width="@dimen/fab_size"
                android:layout_height="@dimen/fab_size"
                android:layout_gravity="bottom|end"
                android:layout_margin="20dp"
                android:background="@drawable/bg_fab"
                android:elevation="10dp">

                <ImageView
                    android:layout_width="@dimen/action_icon_size"
                    android:layout_height="@dimen/action_icon_size"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_zen_chat"
                    app:tint="@color/icon_on_accent"/>

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
